
 // Prisma Schema for CampusMitra Student Organization & Platform Management
 // Database: TiDB Cloud MySQL 8.0 Compatible

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum RoleType {
  ADMIN
  PRESIDENT
  TREASURER
  EVENT_ORGANIZER
  VOLUNTEER
  MEMBER
  STUDENT
}

enum TicketCategory {
  CLUB_QUERY
  WEBSITE_BUG
  ACCESS_RECOVERY
  EVENT_INQUIRY
  PAYMENT_ISSUE
  GENERAL
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ElectionStatus {
  DRAFT
  NOMINATION_OPEN
  VOTING_OPEN
  COMPLETED
  CANCELLED
}

enum CandidateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// New enums for event booking and payments

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
}

enum EventBookingStatus {
  RESERVED
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED
}

// Existing models

model User {
  id              String   @id // Populated with UUID v7
  username        String   @unique
  email           String   @unique
  passwordHash    String?
  fullName        String
  avatarUrl       String?
  googleId        String?  @unique
  phone           String?
  bio             String?  @db.Text
  isActive        Boolean  @default(true)
  isEmailVerified Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  roles                  UserRole[]
  refreshTokens          RefreshToken[]
  ticketsCreated         SupportTicket[]          @relation("TicketsCreated")
  ticketsAssigned        SupportTicket[]          @relation("TicketsAssigned")
  supportMessages        SupportMessage[]
  nominations            ElectionCandidate[]
  votesCast              ElectionVote[]
  notifications          Notification[]
  membershipApplications MembershipApplication[]
  announcements          Announcement[]

  // Added for event booking and Razorpay
  bookings Booking[]
  payments Payment[]

  @@map("users")
}

model Organization {
  id            String   @id
  name          String
  slug          String   @unique
  description   String?  @db.Text
  category      String?
  logoUrl       String?
  coverUrl      String?
  websiteUrl    String?
  instagramUrl  String?
  linkedinUrl   String?
  membershipFee Int      @default(50000)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userRoles              UserRole[]
  supportTickets         SupportTicket[]
  elections              Election[]
  membershipApplications MembershipApplication[]
  announcements          Announcement[]

  // Added for event management
  events Event[]

  @@map("organizations")
}

model UserRole {
  id             String        @id
  userId         String
  role           RoleType      @default(STUDENT)
  organizationId String?
  assignedAt     DateTime      @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@unique([userId, role, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("user_roles")
}

model RefreshToken {
  id         String   @id
  userId     String
  token      String   @unique @db.VarChar(500)
  expiresAt  DateTime
  isRevoked  Boolean  @default(false)
  deviceInfo String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model SupportTicket {
  id             String         @id
  ticketNumber   String         @unique
  subject        String
  description    String         @db.Text
  category       TicketCategory @default(GENERAL)
  priority       TicketPriority @default(MEDIUM)
  status         TicketStatus   @default(OPEN)
  organizationId String?
  createdById    String
  assignedToId   String?
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdBy    User          @relation("TicketsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  assignedTo   User?         @relation("TicketsAssigned", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages     SupportMessage[]

  @@index([createdById])
  @@index([organizationId])
  @@index([status])
  @@map("support_tickets")
}

model SupportMessage {
  id           String   @id
  ticketId     String
  senderId     String
  message      String   @db.Text
  isAdminReply Boolean  @default(false)
  createdAt    DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([senderId])
  @@map("support_messages")
}

model Election {
  id                 String         @id
  title              String
  organizationId     String
  academicYear       String         @default("2026-2027")
  description        String?        @db.Text
  status             ElectionStatus @default(DRAFT)
  nominationDeadline DateTime
  votingStartDate    DateTime
  votingEndDate      DateTime
  winnerCandidateId  String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidates   ElectionCandidate[]
  votes        ElectionVote[]

  @@index([organizationId])
  @@index([status])
  @@map("elections")
}

model ElectionCandidate {
  id                 String          @id // Populated with UUID v7
  electionId         String
  userId             String
  manifesto          String          @db.Text
  statementOfPurpose String?         @db.Text // Why are you applying / Leadership vision
  experience         String?         @db.Text // Relevant experience / Credentials
  status             CandidateStatus @default(PENDING)
  voteCount          Int             @default(0)
  approvedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  election           Election        @relation(fields: [electionId], references: [id], onDelete: Cascade)
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes              ElectionVote[]

  @@unique([electionId, userId])
  @@index([electionId])
  @@index([userId])
  @@map("election_candidates")
}

model ElectionVote {
  id          String   @id
  electionId  String
  candidateId String
  voterId     String
  castAt      DateTime @default(now())

  election  Election          @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidate ElectionCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  voter     User              @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([electionId, voterId])
  @@index([electionId])
  @@index([candidateId])
  @@map("election_votes")
}

model Notification {
  id        String   @id
  userId    String?
  title     String
  message   String   @db.Text
  type      String   @default("SYSTEM")
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

// New models for event booking and Razorpay payments

model Event {
  id             String      @id
  organizationId String
  title          String
  slug           String      @unique
  description    String      @db.Text
  bannerUrl      String?
  venue          String
  startAt        DateTime
  endAt          DateTime
  totalSeats     Int
  memberPrice    Int         // INR paise
  nonMemberPrice Int         // INR paise
  status         EventStatus @default(DRAFT)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bookings     Booking[]

  @@index([organizationId])
  @@index([status, startAt])
  @@map("events")
}

model Booking {
  id                   String             @id
  bookingNumber        String             @unique
  userId               String
  eventId              String
  quantity             Int
  unitPrice            Int                // INR paise per ticket
  totalAmount          Int                // INR paise
  currency             String             @default("INR") @db.VarChar(3)
  status               EventBookingStatus @default(RESERVED)
  reservationExpiresAt DateTime?
  confirmedAt          DateTime?
  checkedInAt          DateTime?
  otpCode              String?            @db.VarChar(10)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  event    Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([userId, createdAt])
  @@index([eventId, status])
  @@index([status, reservationExpiresAt])
  @@map("bookings")
}

model Payment {
  id                 String        @id
  userId             String
  bookingId          String?
  status             PaymentStatus @default(CREATED)
  amount             Int           // INR paise
  currency           String        @default("INR") @db.VarChar(3)

  // Razorpay identifiers; never store API secrets here
  razorpayOrderId    String?       @unique
  razorpayPaymentId  String?       @unique
  razorpaySignature  String?       @db.VarChar(500)

  failureCode        String?
  failureDescription String?       @db.Text
  capturedAt         DateTime?
  failedAt           DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([bookingId])
  @@index([status])
  @@map("payments")
}

model MembershipApplication {
  id                 String            @id
  organizationId     String
  userId             String
  statementOfPurpose String?           @db.Text
  experience         String?           @db.Text
  department         String?
  semester           String?
  status             ApplicationStatus @default(PENDING)
  reviewedAt         DateTime?
  reviewedById       String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([status])
  @@map("membership_applications")
}

model Announcement {
  id             String       @id
  organizationId String
  authorId       String
  title          String
  content        String       @db.Text
  category       String       @default("GENERAL")
  isPinned       Boolean      @default(false)
  isMemberOnly   Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([authorId])
  @@index([createdAt])
  @@map("announcements")
}

