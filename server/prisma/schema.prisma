// Prisma Schema for CampusMitra Student Organization & Platform Management
// Database: TiDB Cloud MySQL 8.0 Compatible

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum RoleType {
  ADMIN
  PRESIDENT
  TREASURER
  EVENT_ORGANIZER
  VOLUNTEER
  MEMBER
  STUDENT
}

enum TicketCategory {
  CLUB_QUERY
  WEBSITE_BUG
  ACCESS_RECOVERY
  EVENT_INQUIRY
  PAYMENT_ISSUE
  GENERAL
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ElectionStatus {
  DRAFT
  NOMINATION_OPEN
  VOTING_OPEN
  COMPLETED
  CANCELLED
}

enum CandidateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
}

enum EventBookingStatus {
  RESERVED
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED
}

// User Model
model User {
  id              String   @id // Populated with UUID v7
  username        String   @unique
  email           String   @unique
  passwordHash    String?
  fullName        String
  avatarUrl       String?
  googleId        String?  @unique
  phone           String?
  bio             String?  @db.Text
  isActive        Boolean  @default(true)
  isEmailVerified Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  roles                  UserRole[]
  refreshTokens          RefreshToken[]
  ticketsCreated         SupportTicket[]          @relation("TicketsCreated")
  ticketsAssigned        SupportTicket[]          @relation("TicketsAssigned")
  supportMessages        SupportMessage[]
  nominations            ElectionCandidate[]
  votesCast              ElectionVote[]
  notifications          Notification[]
  membershipApplications MembershipApplication[]
  announcements          Announcement[]

  // Event booking and Razorpay
  bookings Booking[]
  payments Payment[]
  // Added for event booking and Razorpay
  bookings       Booking[]
  payments       Payment[]
  inchargeEvents Event[]                 @relation("EventIncharge")
  assignedTasks  EventTask[]             @relation("AssignedTasks")

  @@map("users")
}

// Organization Model
model Organization {
  id            String   @id
  name          String
  slug          String   @unique
  description   String?  @db.Text
  category      String?
  logoUrl       String?
  coverUrl      String?
  websiteUrl    String?
  instagramUrl  String?
  linkedinUrl   String?
  membershipFee Int      @default(50000)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userRoles              UserRole[]
  supportTickets         SupportTicket[]
  elections              Election[]
  membershipApplications MembershipApplication[]
  announcements          Announcement[]
  events                 Event[]

  // Treasurer Relations
  treasuryLedgers        TreasuryLedger[]
  treasuryIncomes        TreasuryIncome[]
  treasuryExpenses       TreasuryExpense[]
  reimbursementClaims    ReimbursementClaim[]
  semesterReports        SemesterReport[]
  treasuryPaymentRecords TreasuryPaymentRecord[]
  treasuryAuditLogs      TreasuryAuditLog[]
  duesRecords            DuesRecord[]
  merchProducts          MerchProduct[]
  studentMerchOrders     StudentMerchOrder[]

  // Added for event & merchandise management
  events             Event[]
  merchProducts      MerchProduct[]
  studentMerchOrders StudentMerchOrder[]

  @@map("organizations")
}

// User Roles
model UserRole {
  id             String        @id
  userId         String
  role           RoleType      @default(STUDENT)
  organizationId String?
  assignedAt     DateTime      @default(now())
  duesPaid       Boolean?      @default(false)
  validUntil     DateTime?
  validUntil     DateTime?
  duesPaid       Boolean       @default(true)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@unique([userId, role, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("user_roles")
}

model RefreshToken {
  id         String   @id
  userId     String
  token      String   @unique @db.VarChar(500)
  expiresAt  DateTime
  isRevoked  Boolean  @default(false)
  deviceInfo String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model SupportTicket {
  id             String         @id
  ticketNumber   String         @unique
  subject        String
  description    String         @db.Text
  category       TicketCategory @default(GENERAL)
  priority       TicketPriority @default(MEDIUM)
  status         TicketStatus   @default(OPEN)
  organizationId String?
  createdById    String
  assignedToId   String?
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdBy    User             @relation("TicketsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  assignedTo   User?            @relation("TicketsAssigned", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages     SupportMessage[]

  @@index([createdById])
  @@index([organizationId])
  @@index([status])
  @@map("support_tickets")
}

model SupportMessage {
  id           String   @id
  ticketId     String
  senderId     String
  message      String   @db.Text
  isAdminReply Boolean  @default(false)
  createdAt    DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([senderId])
  @@map("support_messages")
}

model Election {
  id                 String         @id
  title              String
  organizationId     String
  academicYear       String         @default("2026-2027")
  description        String?        @db.Text
  status             ElectionStatus @default(DRAFT)
  nominationDeadline DateTime
  votingStartDate    DateTime
  votingEndDate      DateTime
  winnerCandidateId  String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidates   ElectionCandidate[]
  votes        ElectionVote[]

  @@index([organizationId])
  @@index([status])
  @@map("elections")
}

model ElectionCandidate {
  id                 String          @id // Populated with UUID v7
  electionId         String
  userId             String
  manifesto          String          @db.Text
  statementOfPurpose String?         @db.Text
  experience         String?         @db.Text
  status             CandidateStatus @default(PENDING)
  voteCount          Int             @default(0)
  approvedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  election Election       @relation(fields: [electionId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes    ElectionVote[]

  @@unique([electionId, userId])
  @@index([electionId])
  @@index([userId])
  @@map("election_candidates")
}

model ElectionVote {
  id          String   @id
  electionId  String
  candidateId String
  voterId     String
  castAt      DateTime @default(now())

  election  Election          @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidate ElectionCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  voter     User              @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([electionId, voterId])
  @@index([electionId])
  @@index([candidateId])
  @@map("election_votes")
}

model Notification {
  id        String   @id
  userId    String?
  title     String
  message   String   @db.Text
  type      String   @default("SYSTEM")
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model Event {
  id             String       @id
  organizationId String
  title          String
  slug           String       @unique
  description    String       @db.Text
  bannerUrl      String?
  venue          String
  startAt        DateTime
  endAt          DateTime
  totalSeats     Int
  memberPrice    Int          // INR paise
  nonMemberPrice Int          // INR paise
  status         EventStatus  @default(DRAFT)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  remainingSeats Int          @default(50)
  category       String       @default("Hackathon")
  domain         String       @default("AI/ML")
  mode           String       @default("offline")
  teamsCount     Int          @default(0)
  prizes         String?      @db.Text
  analyticsData  String?      @db.LongText
  inchargeId     String?
  remainingSeats Int         @default(50)
  memberPrice    Int         // INR paise
  nonMemberPrice Int         // INR paise
  category       String      @default("Hackathon")
  domain         String      @default("AI/ML")
  mode           String      @default("offline")
  teamsCount     Int         @default(0)
  prizes         String?     @db.Text
  analyticsData  String?     @db.LongText
  inchargeId     String?
  status         EventStatus @default(DRAFT)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  incharge     User?        @relation("EventIncharge", fields: [inchargeId], references: [id], onDelete: SetNull)
  bookings     Booking[]
  tasks        EventTask[]

  @@index([organizationId])
  @@index([inchargeId])
  @@index([status, startAt])
  @@map("events")
}

model EventTask {
  id           String    @id
  eventId      String
  title        String
  description  String?   @db.Text
  assignedToId String?
  priority     String    @default("MEDIUM")
  status       String    @default("PENDING")
  deadline     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now())

  event      Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([assignedToId])
  @@map("event_tasks")
}

model Booking {
  id                   String             @id
  bookingNumber        String             @unique
  userId               String
  eventId              String
  quantity             Int
  unitPrice            Int                // INR paise per ticket
  totalAmount          Int                // INR paise
  currency             String             @default("INR") @db.VarChar(3)
  status               EventBookingStatus @default(RESERVED)
  reservationExpiresAt DateTime?
  confirmedAt          DateTime?
  checkedInAt          DateTime?
  otpCode              String?            @db.VarChar(10)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  checkedInAt          DateTime?
  otpCode              String?            @db.VarChar(10)

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  event    Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([userId, createdAt])
  @@index([eventId, status])
  @@index([status, reservationExpiresAt])
  @@map("bookings")
}

model Payment {
  id                 String        @id
  userId             String
  bookingId          String?
  status             PaymentStatus @default(CREATED)
  amount             Int           // INR paise
  currency           String        @default("INR") @db.VarChar(3)

  razorpayOrderId    String?       @unique
  razorpayPaymentId  String?       @unique
  razorpaySignature  String?       @db.VarChar(500)

  failureCode        String?
  failureDescription String?       @db.Text
  capturedAt         DateTime?
  failedAt           DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([bookingId])
  @@index([status])
  @@map("payments")
}

model MembershipApplication {
  id                 String            @id
  organizationId     String
  userId             String
  statementOfPurpose String?           @db.Text
  experience         String?           @db.Text
  department         String?
  semester           String?
  status             ApplicationStatus @default(PENDING)
  reviewedAt         DateTime?
  reviewedById       String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([status])
  @@map("membership_applications")
}

model Announcement {
  id             String       @id
  organizationId String
  authorId       String
  title          String
  content        String       @db.Text
  category       String       @default("GENERAL")
  isPinned       Boolean      @default(false)
  isMemberOnly   Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([authorId])
  @@index([createdAt])
  @@map("announcements")
}

model EventTask {
  id           String    @id
  eventId      String
  title        String
  description  String?   @db.Text
  assignedToId String?
  priority     String    @default("MEDIUM")
  status       String    @default("PENDING")
  deadline     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now())

  @@index([assignedToId], map: "idx_event_tasks_assignedToId")
  @@index([eventId], map: "idx_event_tasks_eventId")
  @@map("event_tasks")
}

// =============================================================================
// TREASURER MODULE MODELS
// =============================================================================

model TreasuryLedger {
  id             String   @id
  organizationId String
  academicYear   String   @default("2025–2026")
  semester       String   @default("Spring 2026")
  openingBalance Int      @default(45000)
  totalIncome    Int      @default(0)
  totalExpenses  Int      @default(0)
  netBalance     Int      @default(45000)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, academicYear, semester])
  @@index([organizationId])
  @@map("treasury_ledgers")
}

model TreasuryIncome {
  id            String   @id
  organizationId String
  source        String   // MEMBERSHIP_DUES, TICKET_SALES, MERCHANDISE, FUNDRAISER, SPONSORSHIPS, OTHER
  title         String
  payerName     String
  payerEmail    String?
  payerRoll     String?
  amount        Int      // in INR
  date          DateTime @default(now())
  paymentMethod String   @default("UPI") // UPI, CARD, NET_BANKING, CASH
  paymentId     String
  status        String   @default("VERIFIED") // VERIFIED, SETTLED
  reference     String
  categoryTag   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([source])
  @@map("treasury_incomes")
}

model TreasuryExpense {
  id               String   @id
  organizationId   String
  title            String
  category         String   // VENUE, CATERING, EQUIPMENT, SUPPLIES, MERCHANDISE, MARKETING, LOGISTICS, OTHER
  amount           Int      // in INR
  date             DateTime @default(now())
  vendor           String
  paymentMethod    String   @default("BANK_TRANSFER") // BANK_TRANSFER, UPI, PETTY_CASH, CREDIT_CARD
  receiptNote      String?
  receiptInvoiceNo String?
  receiptUrl       String?
  recordedBy       String?
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([category])
  @@map("treasury_expenses")
}

model ReimbursementClaim {
  id                  String    @id
  organizationId      String
  volunteerName       String
  volunteerEmail      String
  volunteerRoll       String
  volunteerDepartment String
  projectName         String
  title               String
  category            String
  amount              Int
  dateSubmitted       DateTime  @default(now())
  status              String    @default("PENDING") // PENDING, APPROVED, REJECTED, REIMBURSED
  receiptNote         String?
  receipt             Json?
  reviewerNotes       String?   @db.Text
  reviewedBy          String?
  approvedAt          DateTime?
  rejectedAt          DateTime?
  rejectionReason     String?   @db.Text
  payoutDetails       Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@map("reimbursement_claims")
}

model SemesterReport {
  id                  String   @id
  organizationId      String
  semester            String
  academicYear        String
  status              String   @default("ACTIVE_INTERIM") // ACTIVE_INTERIM, AUDITED_FINAL
  openingBalance      Int
  incomeBreakdown     Json
  expenseBreakdown    Json
  netOperatingSurplus Int
  netClosingBalance   Int
  auditedBy           String?
  facultyAdvisor      String?
  certifiedDate       String?
  auditHash           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("semester_reports")
}

model TreasuryPaymentRecord {
  id             String   @id
  organizationId String
  timestamp      DateTime @default(now())
  type           String   // INFLOW, OUTFLOW
  sourceCategory String
  partyName      String
  partyDetails   String
  amount         Int
  method         String   // UPI, IMPS, NEFT, CARD, NET_BANKING, CASH
  referenceId    String
  status         String   @default("SETTLED") // SETTLED, CLEARED, DISBURSED
  verifiedHash   String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([type])
  @@map("treasury_payment_records")
}

model TreasuryAuditLog {
  id               String   @id
  organizationId   String
  timestamp        DateTime @default(now())
  action           String   // PAYOUT_RECORDED, CLAIM_APPROVED, CLAIM_REJECTED, EXPENSE_RECORDED, INCOME_LOGGED, REPORT_GENERATED, AUDIT_SEALED
  actor            String
  details          String   @db.Text
  amount           Int?
  referenceId      String
  verificationHash String
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("treasury_audit_logs")
}

model DuesRecord {
  id                 String   @id
  organizationId     String
  studentId          String
  name               String
  email              String
  phone              String?
  rollNumber         String
  department         String
  yearOfStudy        String
  membershipStatus   String   @default("ACTIVE")
  clubRole           String   @default("MEMBER")
  academicYear       String   @default("2025–2026")
  annualFee          Int      @default(250)
  amountPaid         Int      @default(0)
  outstandingBalance Int      @default(250)
  paymentStatus      String   @default("PENDING") // PAID, PARTIAL, PENDING, OVERDUE, WAIVED
  lastPaymentDate    String?
  paymentMethod      String?
  transactionRef     String?
  dueDate            String?
  notes              String?  @db.Text
  paymentHistory     Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([paymentStatus])
  @@map("dues_records")
}

model MerchProduct {
  id                String   @id
  organizationId    String
  name              String
  description       String   @db.Text
  category          String
  image             String   @db.Text
  sellingPrice      Int
  costPrice         Int?
  memberPrice       Int?
  sku               String
  status            String   @default("ACTIVE") // ACTIVE, DRAFT, ARCHIVED
  status            String   @default("ACTIVE")
  lowStockThreshold Int      @default(10)
  variants          Json
  stockHistory      Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([category])
  @@map("merch_products")
}

model StudentMerchOrder {
  id                 String   @id
  organizationId     String
  orderNumber        String   @unique
  orderNumber        String
  orderDate          String
  studentName        String
  studentId          String
  studentEmail       String
  studentPhone       String?
  department         String?
  productId          String
  productName        String
  variantSize        String
  quantity           Int      @default(1)
  unitPrice          Int
  orderTotal         Int
  amountPaid         Int
  outstandingBalance Int      @default(0)
  paymentStatus      String   @default("PAID")
  fulfillmentStatus  String   @default("PENDING")
  paymentMethod      String?
  transactionRef     String?
  expectedPickupDate String?
  handoverAt         String?
  handoverBy         String?
  notes              String?  @db.Text
  cancellationReason String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([studentEmail])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@map("student_merch_orders")
}

