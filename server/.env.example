# Server Configuration
PORT=5000
NODE_ENV=development
APP_NAME=student-organization-system-backend
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE?sslaccept=strict"

# JWT Authentication
JWT_ACCESS_SECRET="your-secure-access-jwt-secret-at-least-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS=7

# Google OAuth 2.0 Credentials (obtain from Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:5000/api/v1/auth/google/callback"

# Client Web App Hand-off
FRONTEND_URL="http://localhost:3000"

# Razorpay Test Credentials (for ticketing, membership and dues payments)
RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"
RAZORPAY_KEY_SECRET="placeholder_key_secret"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# Redis Cache & Concurrency Lock (Docker service: localhost:6379)
REDIS_URL="redis://localhost:6379"
