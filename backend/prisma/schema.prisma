// Prisma configuration for TiDB (MySQL-compatible interface)
// Do NOT define business-specific models until the hackathon problem statement is announced.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Infrastructure entity required by Prisma Client generator.
// Preserved for database connection verification.
model HealthCheckLog {
  id        String   @id @default(uuid())
  checkedAt DateTime @default(now())

  @@map("_system_health_check_logs")
}

// -----------------------------------------------------------------------------
// CampusFlow: User & Authentication Core
// -----------------------------------------------------------------------------

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum RoleType {
  STUDENT
  MEMBER
  VOLUNTEER
  EVENT_ORGANIZER
  TREASURER
  PRESIDENT
  ADMIN
}

model User {
  id        String        @id @default(uuid())
  name      String?
  email     String?
  avatarUrl String?       @map("avatar_url")
  status    AccountStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  oauthAccounts OAuthAccount[]
  roles         UserRole[]
  refreshTokens RefreshToken[]

  // Multi-tenant club relations
  clubMemberships   ClubMember[]
  clubRoles         ClubRole[]
  eventTickets      EventTicket[]
  merchandiseOrders MerchandiseOrder[]
  assignedTasks     VolunteerTask[]    @relation("AssignedVolunteer")
  createdTasks      VolunteerTask[]    @relation("CreatedTasks")
  submittedExpenses ExpenseClaim[]     @relation("SubmittedExpenses")
  reviewedExpenses  ExpenseClaim[]     @relation("ReviewedExpenses")

  @@map("users")
}

model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  provider          String
  providerAccountId String   @map("provider_account_id")
  email             String?
  emailVerified     Boolean  @default(false) @map("email_verified")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  role       RoleType
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@map("user_roles")
}

model RefreshToken {
  id                  String    @id @default(uuid())
  tokenHash           String    @unique @map("token_hash")
  userId              String    @map("user_id")
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedByTokenHash String?   @map("replaced_by_token_hash")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// =============================================================================
// MULTI-TENANT STUDENT ORGANIZATION CORE (Tenant = Club)
// =============================================================================

enum ClubStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  PENDING_PAYMENT
  EXPIRED
  CANCELLED
}

enum MembershipTier {
  STANDARD
  PREMIUM
  LIFETIME
}

enum EventStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_CLOSED
  COMPLETED
  CANCELLED
}

enum TicketStatus {
  ISSUED
  CHECKED_IN
  REFUNDED
  CANCELLED
}

enum AnnouncementCategory {
  GENERAL
  MEETING
  EVENT
  URGENT
  DEADLINE
}

enum TargetAudience {
  ALL
  MEMBERS_ONLY
  OFFICERS_ONLY
}

enum MerchandiseStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum FulfillmentStatus {
  ORDER_PLACED
  PROCESSING
  READY_FOR_PICKUP
  FULFILLED
  CANCELLED
}

enum TaskCategory {
  GENERAL
  BAKING
  SUPPLIES
  TABLE_STAFFING
  PROMOTION
  LOGISTICS
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ExpenseCategory {
  SUPPLIES
  FOOD
  VENUE
  DECORATION
  PRINTING
  EQUIPMENT
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  REIMBURSED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  MEMBERSHIP_DUES
  TICKET_SALES
  MERCHANDISE_SALES
  FUNDRAISER
  DONATION
  EXPENSE_REIMBURSEMENT
  SUPPLIES
  EQUIPMENT
  OTHER
}

// Tenant: Student Club or Organization (e.g., Skyline Student Association)
model Club {
  id            String     @id @default(uuid())
  name          String     // "Skyline Student Association"
  slug          String     @unique // "skyline-sa"
  description   String?    @db.Text
  logoUrl       String?    @map("logo_url")
  bannerUrl     String?    @map("banner_url")
  category      String     @default("General") // Academic, Cultural, Tech, Leadership
  collegeName   String     @default("Dr.SNS Rajalakshmi College Of Arts and Science") @map("college_name")
  duesAmount    Decimal    @default(250.00) @map("dues_amount") @db.Decimal(10, 2)
  duesInterval  String     @default("ANNUAL") @map("dues_interval")
  status        ClubStatus @default(ACTIVE)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  members           ClubMember[]
  clubRoles         ClubRole[]
  events            Event[]
  announcements     Announcement[]
  merchandise       MerchandiseItem[]
  merchandiseOrders MerchandiseOrder[]
  tasks             VolunteerTask[]
  expenseClaims     ExpenseClaim[]
  transactions      FinancialTransaction[]
  budgets           ClubBudget[]

  @@map("clubs")
}

// Club Membership Record: dues tracking, renewal tracking, digital membership pass
model ClubMember {
  id                  String           @id @default(uuid())
  clubId              String           @map("club_id")
  userId              String           @map("user_id")
  membershipNumber    String           @unique @map("membership_number") // "SSA-2026-0042"
  tier                MembershipTier   @default(STANDARD)
  status              MembershipStatus @default(ACTIVE)
  duesPaid            Boolean          @default(true) @map("dues_paid")
  duesAmountPaid      Decimal          @default(250.00) @map("dues_amount_paid") @db.Decimal(10, 2)
  duesPaidAt          DateTime?        @map("dues_paid_at")
  duesExpiresAt       DateTime?        @map("dues_expires_at") // End of academic year for renewal reminder
  renewalReminderSent Boolean          @default(false) @map("renewal_reminder_sent")
  joinedAt            DateTime         @default(now()) @map("joined_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([clubId])
  @@index([userId])
  @@map("club_members")
}

// Club-Specific Role Mapping (multi-tenant roles per club)
model ClubRole {
  id         String   @id @default(uuid())
  clubId     String   @map("club_id")
  userId     String   @map("user_id")
  role       RoleType
  assignedAt DateTime @default(now()) @map("assigned_at")

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId, role])
  @@index([clubId])
  @@index([userId])
  @@map("club_roles")
}

// Events: Spring Gala, Hackathons, Fundraisers, Workshops
model Event {
  id          String      @id @default(uuid())
  clubId      String      @map("club_id")
  title       String      // "Spring Gala 2026"
  slug        String
  description String?     @db.Text
  location    String      // "Main Campus Auditorium"
  startDate   DateTime    @map("start_date")
  endDate     DateTime    @map("end_date")
  capacity    Int         @default(500)
  status      EventStatus @default(PUBLISHED)
  imageUrl    String?     @map("image_url")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  club          Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  ticketTiers   TicketTier[]
  tickets       EventTicket[]
  tasks         VolunteerTask[]
  expenseClaims ExpenseClaim[]

  @@unique([clubId, slug])
  @@index([clubId])
  @@map("events")
}

// Ticket Pricing Tiers: member discounts & capacity limits
model TicketTier {
  id             String   @id @default(uuid())
  eventId        String   @map("event_id")
  name           String   // "Club Member Pass" vs "General Non-Member"
  memberPrice    Decimal  @default(100.00) @map("member_price") @db.Decimal(10, 2)
  nonMemberPrice Decimal  @default(250.00) @map("non_member_price") @db.Decimal(10, 2)
  totalCapacity  Int      @default(200) @map("total_capacity")
  soldCount      Int      @default(0) @map("sold_count")
  createdAt      DateTime @default(now()) @map("created_at")

  event   Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets EventTicket[]

  @@index([eventId])
  @@map("ticket_tiers")
}

// Event Tickets & Instant Door Check-in
model EventTicket {
  id             String       @id @default(uuid())
  eventId        String       @map("event_id")
  ticketTierId   String       @map("ticket_tier_id")
  userId         String       @map("user_id")
  ticketCode     String       @unique @map("ticket_code") // "TKT-GALA-9841"
  qrCodeData     String       @map("qr_code_data") // Fast scanning payload
  isMemberTicket Boolean      @default(false) @map("is_member_ticket")
  pricePaid      Decimal      @map("price_paid") @db.Decimal(10, 2)
  status         TicketStatus @default(ISSUED)
  checkedInAt    DateTime?    @map("checked_in_at")
  checkedInById  String?      @map("checked_in_by_id")
  createdAt      DateTime     @default(now()) @map("created_at")

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketTier TicketTier @relation(fields: [ticketTierId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([userId])
  @@map("event_tickets")
}

// Announcements: Centralized board replacing chaotic WhatsApp groups
model Announcement {
  id             String               @id @default(uuid())
  clubId         String               @map("club_id")
  title          String
  content        String               @db.Text
  category       AnnouncementCategory @default(GENERAL)
  targetAudience TargetAudience       @default(ALL) @map("target_audience")
  isPinned       Boolean              @default(false) @map("is_pinned")
  publishedAt    DateTime             @default(now()) @map("published_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@map("announcements")
}

// Merchandise: Branded Hoodies and T-Shirts store
model MerchandiseItem {
  id          String            @id @default(uuid())
  clubId      String            @map("club_id")
  name        String            // "Skyline Embroidered Club Hoodie"
  description String?           @db.Text
  imageUrl    String?           @map("image_url")
  basePrice   Decimal           @default(850.00) @map("base_price") @db.Decimal(10, 2)
  memberPrice Decimal           @default(700.00) @map("member_price") @db.Decimal(10, 2)
  status      MerchandiseStatus @default(IN_STOCK)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  club     Club                   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  variants MerchandiseVariant[]

  @@index([clubId])
  @@map("merchandise_items")
}

// Merchandise Variants: S, M, L, XL with live stock tracking
model MerchandiseVariant {
  id                String   @id @default(uuid())
  merchandiseItemId String   @map("merchandise_item_id")
  size              String   // "S", "M", "L", "XL", "XXL"
  color             String   @default("Navy Blue")
  stockQuantity     Int      @default(50) @map("stock_quantity")
  reservedQuantity  Int      @default(0) @map("reserved_quantity")
  createdAt         DateTime @default(now()) @map("created_at")

  merchandiseItem MerchandiseItem        @relation(fields: [merchandiseItemId], references: [id], onDelete: Cascade)
  orderItems      MerchandiseOrderItem[]

  @@index([merchandiseItemId])
  @@map("merchandise_variants")
}

// Merchandise Orders: Phone ordering & pre-order collection
model MerchandiseOrder {
  id                String            @id @default(uuid())
  clubId            String            @map("club_id")
  userId            String            @map("user_id")
  orderNumber       String            @unique @map("order_number") // "ORD-MERCH-3810"
  totalAmount       Decimal           @map("total_amount") @db.Decimal(10, 2)
  paymentStatus     PaymentStatus     @default(PAID) @map("payment_status")
  fulfillmentStatus FulfillmentStatus @default(ORDER_PLACED) @map("fulfillment_status")
  pickupNotes       String?           @map("pickup_notes")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  club       Club                   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems MerchandiseOrderItem[]

  @@index([clubId])
  @@index([userId])
  @@map("merchandise_orders")
}

model MerchandiseOrderItem {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  variantId String  @map("variant_id")
  quantity  Int     @default(1)
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)

  order   MerchandiseOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant MerchandiseVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([variantId])
  @@map("merchandise_order_items")
}

// Volunteer Tasks: Fundraiser planning (baking, supplies, table staffing)
model VolunteerTask {
  id               String       @id @default(uuid())
  clubId           String       @map("club_id")
  eventId          String?      @map("event_id")
  title            String       // "Bake chocolate cookies (50 pcs)"
  description      String?      @db.Text
  category         TaskCategory @default(GENERAL)
  status           TaskStatus   @default(TODO)
  priority         TaskPriority @default(MEDIUM)
  assignedToUserId String?      @map("assigned_to_user_id")
  createdById      String       @map("created_by_id")
  dueDate          DateTime?    @map("due_date")
  completedAt      DateTime?    @map("completed_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  club       Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  event      Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  assignedTo User?  @relation("AssignedVolunteer", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdBy  User   @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@index([eventId])
  @@index([assignedToUserId])
  @@map("volunteer_tasks")
}

// Volunteer Expense Claims & Receipts
model ExpenseClaim {
  id                String          @id @default(uuid())
  clubId            String          @map("club_id")
  eventId           String?         @map("event_id")
  submittedByUserId String          @map("submitted_by_user_id")
  title             String          // "Bake sale baking ingredients & packaging"
  amount            Decimal         @db.Decimal(10, 2)
  category          ExpenseCategory @default(SUPPLIES)
  receiptUrl        String?         @map("receipt_url")
  notes             String?         @db.Text
  status            ExpenseStatus   @default(PENDING)
  reviewedById      String?         @map("reviewed_by_id")
  reviewedAt        DateTime?       @map("reviewed_at")
  reimbursedAt      DateTime?       @map("reimbursed_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  club        Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  event       Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  submittedBy User   @relation("SubmittedExpenses", fields: [submittedByUserId], references: [id], onDelete: Cascade)
  reviewedBy  User?  @relation("ReviewedExpenses", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([clubId])
  @@index([eventId])
  @@index([submittedByUserId])
  @@map("expense_claims")
}

// Treasurer Unified Ledger: Dues, ticket sales, merchandise, reimbursements
model FinancialTransaction {
  id            String              @id @default(uuid())
  clubId        String              @map("club_id")
  type          TransactionType     // INCOME | EXPENSE
  category      TransactionCategory
  amount        Decimal             @db.Decimal(10, 2)
  description   String              // "Spring Gala Ticket Sales (120 Member / 45 Non-member)"
  referenceType String?             @map("reference_type") // "TICKET" | "MERCHANDISE" | "EXPENSE" | "MEMBERSHIP"
  referenceId   String?             @map("reference_id")
  recordedById  String?             @map("recorded_by_id")
  createdAt     DateTime            @default(now()) @map("created_at")

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@index([type])
  @@map("financial_transactions")
}

// Club Budget Summary per Semester / Academic Year
model ClubBudget {
  id             String   @id @default(uuid())
  clubId         String   @map("club_id")
  academicYear   String   @map("academic_year") // "2025-2026"
  semester       String   // "Spring 2026"
  initialBalance Decimal  @default(50000.00) @map("initial_balance") @db.Decimal(10, 2)
  totalIncome    Decimal  @default(0.00) @map("total_income") @db.Decimal(10, 2)
  totalExpenses  Decimal  @default(0.00) @map("total_expenses") @db.Decimal(10, 2)
  currentBalance Decimal  @default(50000.00) @map("current_balance") @db.Decimal(10, 2)
  updatedAt      DateTime @updatedAt @map("updated_at")

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, academicYear, semester])
  @@index([clubId])
  @@map("club_budgets")
}
